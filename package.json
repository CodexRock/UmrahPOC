{
  "name": "umrah-proof",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "worker": "tsx src/worker.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "validate:conversation": "node --import tsx scripts/validate-conversation.ts",
    "test:browser": "node scripts/browser-smoke.mjs",
    "check": "tsc --noEmit",
    "doctor:cli": "node --import tsx scripts/cli-smoke.ts",
    "doctor": "node --import tsx scripts/doctor.ts",
    "probe": "node --import tsx scripts/probe.ts",
    "dev": "node scripts/dev.mjs"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "tsx": "4.20.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "playwright-core": "1.56.1",
    "typescript": "5.9.3"
  }
}
